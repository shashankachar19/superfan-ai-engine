# SuperFan AI Environment Configuration
# Copy this file to .env and fill in your actual values

# Project Settings
PROJECT_NAME="SuperFan AI"

# Database (MongoDB)
MONGODB_URI="mongodb://localhost:27017"
DATABASE_NAME="superfan_ai"

# AI Providers (Gemini)
# You can define multiple keys for fallback
GEMINI_API_KEY_1=""
GEMINI_API_KEY_2=""

# Authentication
# Run `openssl rand -hex 32` to generate a secure secret
JWT_SECRET="development_secret_do_not_use_in_prod"

# Optional Services
REDIS_URL="redis://localhost:6379"
VECTOR_DB_TYPE="chroma" # options: chroma, faiss, pinecone
