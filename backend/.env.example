# Server Configuration
PORT=8000
ENVIRONMENT=development

# LLM Models Configuration (LiteLLM Format)
# You can use models from OpenAI, Anthropic, Gemini, Groq, Ollama, etc.
# Format: provider/model-name (e.g., openai/gpt-4o, groq/llama3-70b-8192, ollama/llama3)
CHAT_MODEL="gemini/gemini-1.5-flash"
CONTENT_MODEL="gemini/gemini-1.5-flash"
STORY_MODEL="gemini/gemini-1.5-flash"
MEMORY_MODEL="gemini/gemini-1.5-flash"
RECOMMENDATION_MODEL="gemini/gemini-1.5-flash"

# API Keys (Only provide the ones for models you are actually using)
GEMINI_API_KEY="your_gemini_key_here"
OPENAI_API_KEY=""
GROQ_API_KEY=""
ANTHROPIC_API_KEY=""

# MongoDB Configuration
MONGODB_URI="mongodb://localhost:27017"
DATABASE_NAME="superfan_ai"

# Auth
JWT_SECRET="super-secret-key-change-in-production"
